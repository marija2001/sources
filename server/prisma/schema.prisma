generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String    @unique
  image          String?
  bookmarked     Json[]
}
model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  image       String
  company     String?
  website     String?
  template    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
}

/// Prikaz na home-u (HomeServices sekcija). iconKey mapira se na react-icons u klijentu.
model HomeService {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  iconKey   String
  title     String
  blurb     String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stranica /team — bio je niz paragrafa (Json niz stringova u bazi).
model TeamMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  photo     String
  bio       Json
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}